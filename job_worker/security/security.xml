<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_queue_job" model="ir.module.category">
        <field name="name">Queue Job</field>
        <field name="description">Queue job operations and configuration</field>
        <field name="sequence">30</field>
    </record>

    <record id="res_groups_privilege_queue_job" model="res.groups.privilege">
        <field name="name">Queue Job</field>
        <field name="category_id" ref="module_category_queue_job" />
        <field name="sequence">10</field>
    </record>

    <record id="group_queue_job_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_queue_job" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_queue_job_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_queue_job" />
        <field name="implied_ids" eval="[(4, ref('group_queue_job_user'))]" />
    </record>
</odoo>
