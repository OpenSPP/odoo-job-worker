<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_queue_limit_tree" model="ir.ui.view">
        <field name="name">queue.limit.tree</field>
        <field name="model">queue.limit</field>
        <field name="arch" type="xml">
            <list string="Channel Limits" editable="bottom">
                <field name="name" />
                <field name="limit" />
                <field name="rate_limit" />
            </list>
        </field>
    </record>

    <record id="view_queue_limit_form" model="ir.ui.view">
        <field name="name">queue.limit.form</field>
        <field name="model">queue.limit</field>
        <field name="arch" type="xml">
            <form string="Channel Limit">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="limit" />
                        <field name="rate_limit" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_queue_limit" model="ir.actions.act_window">
        <field name="name">Channel Limits</field>
        <field name="res_model">queue.limit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
